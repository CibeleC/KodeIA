# Copie para .env e preencha. Nunca envie o .env ao GitHub.
LLM_API_KEY=coloque_sua_chave_aqui
# Opcional: endpoint compatível com OpenAI (ex.: Groq, Gemini). Vazio = OpenAI.
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Opcional: se definido, /classificar exige o cabeçalho X-API-Key com este valor.
# Use em produção (API pública). Deixe vazio para uso local.
API_TOKEN=
